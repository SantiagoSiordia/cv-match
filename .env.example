# Optional: persistent data directory (Docker/EFS). Defaults to cwd.
# CV_MATCH_DATA_ROOT=/data

# Amazon Bedrock — text (Claude) + embeddings (Titan). Use the same credential chain as the AWS CLI.
# Set AWS_PROFILE to match `aws configure list-profiles` (e.g. your named profile).
# If AWS_REGION is unset, region is read from ~/.aws/config for that profile (like the CLI).
# AWS_PROFILE=
# AWS_REGION=us-east-1
# BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Parallel Titan embedding calls (default 3; raise slowly if you hit rate limits).
# EMBED_CONCURRENCY=3

# Bulk / evaluate throughput (optional)
# EVALUATE_CV_CONCURRENCY=3        — parallel compatibility LLM calls per job (non-batch mode)
# BULK_JOB_CONCURRENCY=2         — parallel jobs during bulk evaluate
# BULK_LLM_GLOBAL_CONCURRENCY=4  — max in-flight compatibility LLM calls across all bulk jobs; set 0 to disable
# LLM_THROTTLE_MAX_RETRIES=6     — retries with backoff on Bedrock rate limits / transient errors
# EVALUATE_LOG_TIMING=1          — JSON lines to stdout: matrix, per-CV, per-job timings
